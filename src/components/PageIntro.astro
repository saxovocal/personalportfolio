---
interface Props { eyebrow: string; title: string; description?: string; }
const {eyebrow, title, description} = Astro.props;
---
<section class="page-intro container"><div class="eyebrow"><span class="small-rule" />{eyebrow}</div><h1>{title.split('<br />').map(line => <span class="title-line">{line}</span>)}</h1>{description && <p class="lede">{description}</p>}<slot /></section>
