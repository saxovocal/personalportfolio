---
import media from '../data/media.json';
import SwingArt from './SwingArt.astro';
const youtubeUrl = (src: string) => {
  try {
    const url = new URL(src);
    if (url.hostname === 'www.youtube-nocookie.com' && /^\/embed\/[A-Za-z0-9_-]+$/.test(url.pathname)) return url.href;
  } catch {}
  return undefined;
};
---
<div class="media-grid">
  {media.map(item => <figure style="margin:0">
    <div class="media-frame">
      {item.type === 'youtube' && youtubeUrl(item.src) ? <iframe src={youtubeUrl(item.src)} title={item.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" /> : item.type === 'video' && item.src.startsWith('/') ? <video controls preload="none" poster={item.poster || undefined} aria-label={item.title}><source src={item.src} type="video/mp4" /><track kind="captions" src={item.src.replace(/\.mp4$/, '.vtt')} srclang="en" label="English" default /></video> : item.type === 'photo' && item.src.startsWith('/') ? <img src={item.src} alt={item.description} width="960" height="600" loading="lazy" /> : <><SwingArt /><span class="media-placeholder-label">{item.caption}</span></>}
    </div><figcaption class="media-caption"><h3>{item.title}</h3><p>{item.description}</p></figcaption>
  </figure>)}
</div>
